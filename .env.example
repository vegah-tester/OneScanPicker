# ==============================================================================
# ONESCANPICKER ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. RUNTIME MODE
# Options:
#   - 'mock'       : Local SQLite database (isolated development)
#   - 'direct'     : Direct On-Premise SAP Gateway HTTP/HTTPS connection (for RDP/LAN)
#   - 'production' : SAP BTP Destination Service & Cloud Connector tunnel
# ------------------------------------------------------------------------------
ONE_SCAN_MODE=mock

# ------------------------------------------------------------------------------
# 2. LOCAL SERVER PORTS & DB
# ------------------------------------------------------------------------------
PORT=4004
UI5_PORT=8080
CDS_REQUIRES_DB_KIND=sqlite

# ------------------------------------------------------------------------------
# 3. DIRECT ON-PREMISE SAP GATEWAY / EWM CONFIGURATION (Used when MODE=direct)
# ------------------------------------------------------------------------------
SAP_EWM_HOST=localhost
SAP_EWM_PORT=8000
SAP_EWM_USE_SSL=false
SAP_EWM_STRICT_SSL=false
SAP_EWM_CLIENT=100
SAP_EWM_USER=SAP_USER
SAP_EWM_PASSWORD=SAP_PASSWORD
SAP_EWM_BASE_PATH=/sap/opu/odata/scwm/WAREHOUSE_TASK_SRV
SAP_EWM_TASK_ENTITY=WarehouseTasks
SAP_EWM_CONFIRM_FUNCTION=ConfirmWarehouseTask
SAP_EWM_TIMEOUT_MS=15000
SAP_EWM_FALLBACK_SIMULATION=true

# ------------------------------------------------------------------------------
# 4. SAP BTP DESTINATION SERVICE & CLOUD CONNECTOR (Used when MODE=production)
# ------------------------------------------------------------------------------
ONE_SCAN_DESTINATION_NAME=SAP_EWM_DESTINATION
SAP_EWM_BASE_URL=https://sap-ewm.btp.internal/odata/v2/