<mvc:View
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  controllerName="onescanpicker.ui5.controller.History">
  <Page
    id="historyPage"
    title="Pick History"
    showNavButton="false"
    class="sapUiResponsivePadding--content">
    <headerContent>
      <Button
        id="refreshHistoryButton"
        icon="sap-icon://refresh"
        text="Refresh"
        tooltip="Reload pick scan history"
        press=".onRefresh" />
    </headerContent>
    <subHeader>
      <OverflowToolbar>
        <SearchField
          id="historySearchField"
          placeholder="Filter by Scan String, Material, Bin, or Message..."
          width="40%"
          search=".onSearch" />
      </OverflowToolbar>
    </subHeader>
    <content>
      <Table
        id="historyTable"
        items="{/Scans}"
        growing="true"
        growingThreshold="20"
        noDataText="No scan history records logged yet.">
        <headerToolbar>
          <OverflowToolbar>
            <Title text="Audit Log &amp; Verification History" level="H3" />
            <ToolbarSpacer />
            <Text text="Synchronized with CAP ScanRecords entity" />
          </OverflowToolbar>
        </headerToolbar>
        <columns>
          <Column minScreenWidth="Tablet" demandPopin="false">
            <Text text="Scan Value Payload" />
          </Column>
          <Column minScreenWidth="Tablet" demandPopin="true">
            <Text text="Parsed Bin" />
          </Column>
          <Column minScreenWidth="Tablet" demandPopin="true">
            <Text text="Material" />
          </Column>
          <Column minScreenWidth="Desktop" demandPopin="true">
            <Text text="Handling Unit" />
          </Column>
          <Column minScreenWidth="Desktop" demandPopin="true">
            <Text text="Serial Number" />
          </Column>
          <Column hAlign="Center">
            <Text text="Verification" />
          </Column>
          <Column minScreenWidth="Tablet" demandPopin="true">
            <Text text="Message / Details" />
          </Column>
        </columns>
        <items>
          <ColumnListItem>
            <cells>
              <ObjectIdentifier
                title="{scanValue}" />
              <ObjectStatus
                text="{parsedBin}"
                icon="sap-icon://functional-location" />
              <Text text="{material}" />
              <Text text="{handlingUnit}" />
              <Text text="{serialNumber}" />
              <ObjectStatus
                text="{= ${isValid} ? 'Valid' : 'Invalid' }"
                state="{= ${isValid} ? 'Success' : 'Error' }"
                icon="{= ${isValid} ? 'sap-icon://accept' : 'sap-icon://error' }" />
              <Text text="{message}" />
            </cells>
          </ColumnListItem>
        </items>
      </Table>
    </content>
  </Page>
</mvc:View>